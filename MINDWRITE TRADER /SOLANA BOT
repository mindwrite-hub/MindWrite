  function sparkPoints(spark){
    const mn=Math.min(...spark), mx=Math.max(...spark), rng=(mx-mn)||1;
    return spark.map((v,i)=>((i/(spark.length-1))*76).toFixed(1)+','+(20-((v-mn)/rng)*16).toFixed(1)).join(' ');
  }
  function renderObservables(){
    $('observables').innerHTML = state.observables.map(o=>`
      <div class="obs">
        <div class="obs-l">
          <div class="obs-name"><span class="d" style="background:${o.color}"></span><span class="t">${esc(o.label)}</span></div>
          <div class="obs-sub">${esc(o.sub)}</div>
        </div>
        <svg class="obs-spark" viewBox="0 0 76 22" aria-hidden="true"><polyline fill="none" stroke="${o.color}" stroke-width="1.5" stroke-linejoin="round" points="${sparkPoints(o.spark)}"/></svg>
        <div class="obs-r">
          <div class="obs-val">${esc(o.value)}</div>
          <div class="obs-delta" style="color:${o.positive?'var(--profit-soft)':'var(--loss-soft)'}">${o.positive?'▲':'▼'} ${esc(o.delta)}</div>
        </div>
      </div>`).join('');
  }

  /* ===== decision stack ===== */
  function renderDecisions(){
    $('decisions').innerHTML = state.decisions.map(d=>{
      const sel = state.selectedSymbol===d.symbol;
      const badge = d.action==='BUY'?'badge-buy':d.action==='WATCH'?'badge-watch':'badge-skip';
      return `
      <button class="dec tap" data-symbol="${esc(d.symbol)}" aria-pressed="${sel}">
        <span class="dec-top">
          <span class="flC" style="gap:6px">
            <span class="dec-badge ${badge}">${esc(d.action)}</span>
            <span class="dec-sym">${esc(d.symbol)}</span>
          </span>
          <span class="dec-score" style="color:${d.color}">${d.score}</span>
        </span>
        <span class="dec-reason">${esc(d.reason)}</span>
        <span class="conf"><span style="display:block;width:${d.confidence}%;height:100%;background:${d.color}"></span></span>
      </button>`;
    }).join('');
  }

  /* ===== exit simulator ===== */
  function renderExitSim(){
    const s=state.simSeries, w=360,h=135,min=95,range=45;
    let d='', lx=360, ly=20;
    for(let i=0;i<s.length;i++){
      const x=(i/(s.length-1))*w, y=h-((s[i]-min)/range)*h;
      d += (i===0?'M':'L')+' '+x.toFixed(1)+' '+y.toFixed(1)+' ';
      lx=x; ly=y;
    }
    $('exit-path').setAttribute('d',d.trim());
    const pt=$('exit-point'); pt.setAttribute('cx',lx.toFixed(1)); pt.setAttribute('cy',ly.toFixed(1));
    $('exit-atual').textContent = nf2.format(s[s.length-1]);
    $('volume-bins').innerHTML = state.volumeBins.map((b,i)=>{
      const cls = i<3?'p':i>9?'l':'w';
      return `<div class="vbin-row"><div class="vbin ${cls}" style="width:${b}%"></div></div>`;
    }).join('');
  }

  /* ===== slot buyer ===== */
  function renderSlotBars(){
    $('slotbars').innerHTML = state.slotBars.map(b=>{
      const total=b.snipe+b.organic+b.arb, scale=Math.min(100,(total/150)*100);
      return `<div class="slot-col">
        <div class="slot-stack" style="height:${scale}%">
          <div class="snipe" style="height:${(b.snipe/total)*100}%"></div>
          <div class="arb" style="height:${(b.arb/total)*100}%"></div>
          <div class="org" style="height:${(b.organic/total)*100}%"></div>
        </div>
        <span class="slot-lab">${esc(b.slot)}</span>
      </div>`;
    }).join('');
  }

  /* ===== trade tape ===== */
  function renderTradeTape(){
    $('tradetape').innerHTML = state.tradeTape.slice(0,7).map(t=>`
      <tr>
        <td class="c-mut">${esc(t.time)}</td>
        <td class="b c-fg">${esc(t.pair)}</td>
        <td><span class="b" style="color:${t.side==='BUY'?'var(--profit-soft)':'var(--loss-soft)'}">${t.side==='BUY'?'▲':'▼'} ${esc(t.side)}</span></td>
        <td class="ta-r c-fg">${nf2.format(t.sol)}</td>
        <td class="ta-r c-info">${esc(t.slot)}</td>
      </tr>`).join('');
  }

  /* ===== agent log ===== */
  function renderLogs(){
    const logs = state.logFilter==='ALL' ? state.agentLogs : state.agentLogs.filter(l=>l.level===state.logFilter);
    if(!logs.length){ $('logs').innerHTML = `<p class="log-empty">Sem eventos ${esc(state.logFilter)} na janela atual.</p>`; return; }
    $('logs').innerHTML = logs.map(l=>{
      const col = l.level==='SIGNAL'?'var(--info)':l.level==='ORDER'?'var(--profit-soft)':'var(--warn-soft)';
      return `<div class="log-item">
        <div class="log-meta"><span class="c-dim">${esc(l.time)}</span><span class="log-lvl" style="color:${col}">[${esc(l.level)}]</span></div>
        <p class="log-msg">${esc(l.msg)}</p>
      </div>`;
    }).join('');
  }

  /* ===== toggles ===== */
  const ICON_PAUSE = '<svg viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="4" width="4" height="16" rx="1"/><rect x="14" y="4" width="4" height="16" rx="1"/></svg>';
  const ICON_PLAY  = '<svg viewBox="0 0 24 24" fill="currentColor"><polygon points="6 3 20 12 6 21 6 3"/></svg>';

  function applyMotion(){
    $('ticker-track').classList.toggle('paused', !state.isLive || reduced);
  }
  function updateStreamUI(){
    const btn=$('stream-btn');
    btn.className='stream-btn tap '+(state.isLive?'live':'paused');
    btn.setAttribute('aria-pressed', String(state.isLive));
    btn.setAttribute('aria-label', state.isLive?'Pausar stream de telemetria ao vivo':'Retomar stream de telemetria ao vivo');
    $('stream-icon').innerHTML = state.isLive?ICON_PAUSE:ICON_PLAY;
    $('stream-label').textContent = state.isLive?'PAUSAR STREAM':'RETOMAR STREAM';
    const pill=$('ticker-live');
    pill.className='ticker-live '+(state.isLive?'on':'off');
    $('ticker-live-label').textContent = state.isLive?'LIVE FEED':'PAUSADO';
    $('tape-status').textContent = state.isLive?'REAL-TIME':'CONGELADO';
    $('tape-status').style.color = state.isLive?'var(--profit-soft)':'var(--warn-soft)';
    $('m-latency').textContent = state.isLive ? state.latency+'ms' : '—';
    applyMotion();
  }
  function updateCollapseUI(){
    const b=$('collapse-btn');
    b.textContent = state.collapseCore?'EXPANDIR NÚCLEO':'COLAPSAR ESTADOS';
    b.setAttribute('aria-pressed', String(state.collapseCore));
    $('den-mode').textContent = state.collapseCore?'MODO: COLAPSO DE DECISÃO':'MODO: AMPLITUDE RADIAL 60 FPS';
  }

  /* ===== telemetria ===== */
  function telemetry(){
    if(!state.isLive) return;
    const now=new Date();
    const prev={launchesCount:state.launchesCount,blockedCount:state.blockedCount,
                signalsCount:state.signalsCount,labelsToday:state.labelsToday};

    state.latency=Math.floor(8+rand()*9);
    state.launchesCount+=Math.floor(rand()*3);
    if(rand()>0.45) state.blockedCount++;
    if(rand()>0.78) state.signalsCount++;
    if(rand()>0.6) state.labelsToday++;

    const last=state.simSeries[state.simSeries.length-1];
    state.simSeries=state.simSeries.slice(1).concat(
      Number(Math.max(96,Math.min(138,last+(rand()-0.46)*2.6)).toFixed(2)));

    state.volumeBins=state.volumeBins.map((v,i)=>
      (i===4||i===9||rand()>0.65) ? Math.max(12,Math.min(98,v+Math.floor((rand()-0.48)*10))) : v);

    state.observables=state.observables.map(o=>{
      const l=o.spark[o.spark.length-1];
      return {...o,spark:o.spark.slice(1).concat(Number(Math.max(1,l+(rand()-0.47)*(l*0.06||1)).toFixed(2)))};
    });

    state.decisions=state.decisions.map(d=>({...d,
      score:Math.max(12,Math.min(98,d.score+(rand()>0.6?(rand()>0.5?1:-1):0)))}));

    state.slotBars=state.slotBars.slice(1).concat({
      slot:'S-'+Math.floor(10+rand()*89), snipe:Math.floor(15+rand()*32),
      organic:Math.floor(42+rand()*40), arb:Math.floor(12+rand()*22)});

    const pairs=['$WIFCAT','$SOLAPEX','$NEURAL','$ORBITX','$BONKAI'];
    const pair=pairs[Math.floor(rand()*pairs.length)];
    const isBuy=rand()>0.32;
    const trade={id:Date.now()+rand(),time:fmtClock(now),pair,side:isBuy?'BUY':'SELL',
      sol:Number((2.5+rand()*24).toFixed(2)), slot:isBuy?'+'+Math.ceil(rand()*3):'0'};
    state.tradeTape=[trade].concat(state.tradeTape.slice(0,11));

    const pool=[
      {level:'SIGNAL',msg:'THE DEN: Amplitude radial 0,91 • '+pair+' convergiu no canal Smart Flow'},
      {level:'ORDER',msg:'Roteamento RPC Helius Staked: '+(isBuy?'COMPRA':'VENDA')+' '+nf2.format(trade.sol)+' SOL em '+pair+' ('+state.latency+'ms)'},
      {level:'RISK',msg:'Check de liquidez & rug-shield OK para '+pair+' • Slippage máx 0,35%'},
    ];
    const ch=pool[Math.floor(rand()*pool.length)];
    state.agentLogs=[{id:Date.now()+rand(),time:fmtClock(now),level:ch.level,msg:ch.msg}].concat(state.agentLogs.slice(0,29));

    renderHeader(prev); renderObservables(); renderDecisions();
    renderExitSim(); renderSlotBars(); renderTradeTape(); renderLogs();
  }

  /* ===== CANVAS 1 — NÚCLEO RADIAL "THE DEN" ===== */
  function startDen(){
    const canvas=$('den-canvas'); if(!canvas) return;
    const ctx=canvas.getContext('2d');

    /* Campo de partículas em 3 camadas de profundidade.
       Camadas contra-rotacionam (parallax) e recuam por alfa/tamanho,
       em vez de 260 raios idênticos saindo do centro. */
    const SPEC=[
      {n:200,cols:['#3A4A63'],                     lineA:.13,dotA:.26,size:0.7,lw:.7,trail:.10,lo:.20,hi:.54,spd:.50,dir: 1},
      {n:130,cols:['#44546B','#38BDF8'],           lineA:.16,dotA:.52,size:1.1,lw:.8,trail:.09,lo:.44,hi:.76,spd:.80,dir:-1},
      {n:70, cols:['#22C55E','#38BDF8','#F59E0B'], lineA:.26,dotA:.90,size:1.6,lw:.9,trail:.12,lo:.62,hi:.92,spd:1.10,dir: 1},
      {n:20, cols:['#FBBF24','#34D399'],           lineA:.34,dotA:1  ,size:2.2,lw:1.1,trail:.16,lo:.86,hi:1.02,spd:1.35,dir: 1},
    ];
    /* Pré-agrupado por camada+cor: 6 lotes → 12 draw calls/frame (antes: 520). */
    const groups=[];
    SPEC.forEach(L=>L.cols.forEach((col,ci)=>{
      const items=[];
      for(let i=ci;i<L.n;i+=L.cols.length){
        items.push({a:(i/L.n)*TAU+(rand()-.5)*.3, lr:L.lo+rand()*(L.hi-L.lo),
                    s:(0.0012+rand()*0.0022)*L.spd*L.dir, ph:rand()*TAU, _x:0, _y:0});
      }
      groups.push({L,col,items});
    }));

    /* Dimensões e gradientes cacheados — sem getBoundingClientRect por frame
       (que forçava reflow síncrono 60×/s). */
    let W=0,H=0,DPR=1,bgGrad=null,nucGrad=null;
    const sync=()=>{
      const r=canvas.getBoundingClientRect();
      if(!r.width||!r.height) return;
      /* Campo de particulas com glows suaves nao desenha texto, entao DPR 1.5
         basta: em tela retina corta ~44% dos pixels por frame sem perda visivel.
         O radar continua em DPR 2 porque rotula os nos. */
      DPR=Math.min(window.devicePixelRatio||1,1.5);
      const cw=Math.floor(r.width*DPR), ch=Math.floor(r.height*DPR);
      if(canvas.width!==cw||canvas.height!==ch){canvas.width=cw;canvas.height=ch;}
      W=r.width; H=r.height;
      const cx=W*.5, cy=H*.5, R=Math.min(W*.36,H*.44);
      bgGrad=ctx.createRadialGradient(cx,cy,4,cx,cy,R*1.15);
      bgGrad.addColorStop(0,'rgba(34,197,94,0.16)');
      bgGrad.addColorStop(0.45,'rgba(34,211,238,0.06)');
      bgGrad.addColorStop(1,'rgba(2,6,23,0)');
      nucGrad=ctx.createRadialGradient(cx,cy,0,cx,cy,34);
      nucGrad.addColorStop(0,'rgba(34,197,94,.5)');
      nucGrad.addColorStop(1,'rgba(34,197,94,0)');
    };
    new ResizeObserver(sync).observe(canvas); sync();

    let tick=0;
    const render=()=>{
      if(document.hidden||!W){ requestAnimationFrame(render); return; }
      ctx.save(); ctx.scale(DPR,DPR); ctx.clearRect(0,0,W,H);
      const adv=animating();
      if(adv) tick+=0.025;

      const cx=W*.5, cy=H*.5, R=Math.min(W*.36,H*.44), cf=cfNow();

      ctx.fillStyle=bgGrad;
      ctx.beginPath(); ctx.arc(cx,cy,R*1.15,0,TAU); ctx.fill();

      ctx.lineWidth=1;
      [[.35,'rgba(30,38,56,.7)',null],[.68,'rgba(30,38,56,.7)',[3,4]],[.98,'rgba(42,52,73,.6)',null]]
      .forEach(([r,c,d])=>{
        ctx.strokeStyle=c; ctx.setLineDash(d||[]);
        ctx.beginPath(); ctx.arc(cx,cy,R*r*cf,0,TAU); ctx.stroke();
      });
      ctx.setLineDash([]);

      /* 7 canais observáveis → núcleo */
      const left=['#22C55E','#38BDF8','#A855F7','#F59E0B','#34D399','#F43F5E','#22D3EE'];
      left.forEach((col,i)=>{
        const sy=((i+0.5)/left.length)*H, a=Math.PI+((i-3)*0.24);
        const ex=cx+Math.cos(a)*(R*0.20*cf), ey=cy+Math.sin(a)*(R*0.20*cf);
        ctx.strokeStyle=col; ctx.globalAlpha=0.5; ctx.lineWidth=1.3;
        ctx.beginPath(); ctx.moveTo(0,sy); ctx.bezierCurveTo(W*0.22,sy,cx-R*0.65,ey,ex,ey); ctx.stroke();
        const p=(tick*0.45+i*0.17)%1, q=1-p;
        const px=3*q*q*p*(W*0.22)+3*q*p*p*(cx-R*0.65)+p*p*p*ex;
        const py=q*q*q*sy+3*q*q*p*sy+3*q*p*p*ey+p*p*p*ey;
        ctx.globalAlpha=0.95; ctx.fillStyle=col;
        ctx.beginPath(); ctx.arc(px,py,2.5,0,TAU); ctx.fill();
      });

      /* núcleo → 6 decisões */
      state.decisions.forEach((d,i)=>{
        const ey=((i+0.5)/state.decisions.length)*H, a=(i-2.5)*0.26;
        const sx=cx+Math.cos(a)*(R*0.22*cf), sy=cy+Math.sin(a)*(R*0.22*cf);
        ctx.strokeStyle=d.color; ctx.globalAlpha=d.action==='BUY'?0.7:0.32;
        ctx.lineWidth=d.action==='BUY'?1.7:1;
        ctx.beginPath(); ctx.moveTo(sx,sy); ctx.bezierCurveTo(cx+R*0.65,sy,W*0.78,ey,W,ey); ctx.stroke();
        if(d.action==='BUY'||d.action==='WATCH'){
          const p=(tick*0.55+i*0.21)%1, q=1-p;
          const px=q*q*q*sx+3*q*q*p*(cx+R*0.65)+3*q*p*p*(W*0.78)+p*p*p*W;
          const py=q*q*q*sy+3*q*q*p*sy+3*q*p*p*ey+p*p*p*ey;
          ctx.globalAlpha=1; ctx.fillStyle=d.color;
          ctx.beginPath(); ctx.arc(px,py,2.7,0,TAU); ctx.fill();
        }
      });

      /* campo de partículas — um path por lote, rastro em vez de raio central */
      for(let g=0;g<groups.length;g++){
        const G=groups[g], L=G.L, it=G.items, n=it.length;
        if(adv) for(let i=0;i<n;i++) it[i].a+=it[i].s;

        ctx.globalAlpha=L.lineA; ctx.strokeStyle=G.col; ctx.lineWidth=L.lw;
        ctx.beginPath();
        for(let i=0;i<n;i++){
          const p=it[i];
          const wv=0.90+Math.sin(tick*1.6+p.ph)*0.10;
          const r=R*p.lr*wv*cf, r0=r-R*L.trail*cf;
          const c=Math.cos(p.a), s=Math.sin(p.a);
          p._x=cx+c*r; p._y=cy+s*r;
          ctx.moveTo(cx+c*r0,cy+s*r0); ctx.lineTo(p._x,p._y);
        }
        ctx.stroke();

        ctx.globalAlpha=L.dotA; ctx.fillStyle=G.col;
        ctx.beginPath();
        for(let i=0;i<n;i++){
          const p=it[i];
          ctx.moveTo(p._x+L.size,p._y);
          ctx.arc(p._x,p._y,L.size,0,TAU);
        }
        ctx.fill();
      }
      ctx.globalAlpha=1;

      /* núcleo central */
      ctx.fillStyle=nucGrad; ctx.beginPath(); ctx.arc(cx,cy,34,0,TAU); ctx.fill();
      ctx.fillStyle='#020617'; ctx.beginPath(); ctx.arc(cx,cy,17,0,TAU); ctx.fill();
      ctx.strokeStyle='#22C55E'; ctx.lineWidth=1.6;
      ctx.beginPath(); ctx.arc(cx,cy,17+Math.sin(tick*2.4)*1.8,0,TAU); ctx.stroke();
      ctx.fillStyle='#22C55E'; ctx.beginPath(); ctx.arc(cx,cy,4.5,0,TAU); ctx.fill();

      ctx.restore();
      requestAnimationFrame(render);
    };
    requestAnimationFrame(render);
  }

  /* ===== CANVAS 2 — RADAR DE CLUSTERS ===== */
  function startRadar(){
    const canvas=$('radar-canvas'); if(!canvas) return;
    const ctx=canvas.getContext('2d');
    const nodes=[
      {id:'A1',x:0.34,y:0.38,r:4.5,color:'#22C55E',label:'Smart #01'},
      {id:'A2',x:0.64,y:0.32,r:4,color:'#38BDF8',label:'Whale SOL'},
      {id:'A3',x:0.72,y:0.63,r:4.5,color:'#F59E0B',label:'Jito Tip'},
      {id:'A4',x:0.42,y:0.71,r:4,color:'#F43F5E',label:'Bundler'},
      {id:'A5',x:0.52,y:0.49,r:6,color:'#A855F7',label:'$WIFCAT'},
    ];
    let sweep=0;
    let w=0,h=0,dpr=1;
    const sync=()=>{
      const r=canvas.getBoundingClientRect();
      if(!r.width||!r.height) return;
      dpr=Math.min(window.devicePixelRatio||1,2);
      const cw=Math.floor(r.width*dpr), ch=Math.floor(r.height*dpr);
      if(canvas.width!==cw||canvas.height!==ch){canvas.width=cw;canvas.height=ch;}
      w=r.width; h=r.height;
    };
    new ResizeObserver(sync).observe(canvas); sync();

    const draw=()=>{
      if(document.hidden||!w){ requestAnimationFrame(draw); return; }
      ctx.save(); ctx.scale(dpr,dpr); ctx.clearRect(0,0,w,h);
      if(animating()) sweep+=0.025;
      const cx=w*0.5, cy=h*0.5, R=Math.min(w,h)*0.43;

      [0.33,0.66,1].forEach(r=>{
        ctx.strokeStyle='rgba(30,38,56,0.95)'; ctx.lineWidth=1;
        ctx.beginPath(); ctx.arc(cx,cy,R*r,0,Math.PI*2); ctx.stroke();
      });
      ctx.strokeStyle='rgba(30,38,56,0.75)';
      ctx.beginPath(); ctx.moveTo(cx-R,cy); ctx.lineTo(cx+R,cy);
      ctx.moveTo(cx,cy-R); ctx.lineTo(cx,cy+R); ctx.stroke();

      const sg=ctx.createLinearGradient(cx,cy,cx+Math.cos(sweep)*R,cy+Math.sin(sweep)*R);
      sg.addColorStop(0,'rgba(34,197,94,.7)'); sg.addColorStop(1,'rgba(34,197,94,0)');
      ctx.strokeStyle=sg; ctx.lineWidth=1.6;
      ctx.beginPath(); ctx.moveTo(cx,cy); ctx.lineTo(cx+Math.cos(sweep)*R,cy+Math.sin(sweep)*R); ctx.stroke();

      const c=nodes[4];
      nodes.slice(0,4).forEach(n=>{
        ctx.strokeStyle=n.id==='A4'?'rgba(239,68,68,0.45)':'rgba(56,189,248,0.3)'; ctx.lineWidth=1;
        ctx.beginPath(); ctx.moveTo(c.x*w,c.y*h); ctx.lineTo(n.x*w,n.y*h); ctx.stroke();
      });
      nodes.forEach((n,i)=>{
        const nx=n.x*w, ny=n.y*h, pulse=Math.sin(sweep*2+i)*2;
        ctx.fillStyle=n.color; ctx.globalAlpha=0.22;
        ctx.beginPath(); ctx.arc(nx,ny,n.r+4+pulse,0,Math.PI*2); ctx.fill();
        ctx.globalAlpha=1; ctx.beginPath(); ctx.arc(nx,ny,n.r,0,Math.PI*2); ctx.fill();
        ctx.fillStyle='#94A3B8'; ctx.font='9px "Fira Code", monospace';
        ctx.fillText(n.label,nx+7,ny+3);
      });
      ctx.restore();
      requestAnimationFrame(draw);
    };
    requestAnimationFrame(draw);
  }

  /* ===== eventos ===== */
  $('stream-btn').addEventListener('click',()=>{ state.isLive=!state.isLive; updateStreamUI(); });
  $('collapse-btn').addEventListener('click',()=>{
    state.collapseCore=!state.collapseCore; retargetCollapse(); updateCollapseUI();
  });
  $('decisions').addEventListener('click',(e)=>{
    const b=e.target.closest('[data-symbol]'); if(!b) return;
    state.selectedSymbol=b.dataset.symbol;
    $('cluster-symbol').textContent=state.selectedSymbol;
    renderDecisions();
  });
  $('logfilter').addEventListener('click',(e)=>{
    const b=e.target.closest('[data-lvl]'); if(!b) return;
    state.logFilter=b.dataset.lvl;
    [...$('logfilter').children].forEach(x=>x.setAttribute('aria-pressed',String(x.dataset.lvl===state.logFilter)));
    renderLogs();
  });

  /* timer cleanup + visibility pause */
  let timer=null;
  const startTimer=()=>{ if(!timer) timer=setInterval(telemetry,1400); };
  const stopTimer =()=>{ if(timer){ clearInterval(timer); timer=null; } };
  document.addEventListener('visibilitychange',()=>{ document.hidden?stopTimer():startTimer(); });

  /* ===== init ===== */
  renderTicker(); renderActBars(); renderHeader(); renderObservables(); renderDecisions();
  renderExitSim(); renderSlotBars(); renderTradeTape(); renderLogs();
  updateStreamUI(); updateCollapseUI();
  $('m-clock').textContent=fmtClock(new Date());
  setInterval(()=>{ $('m-clock').textContent=fmtClock(new Date()); },1000);
  startTimer(); startDen(); startRadar();
})();
</script>
