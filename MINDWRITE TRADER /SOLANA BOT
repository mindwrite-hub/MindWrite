<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>MINDWRITE TRADER // SOLANA BOT</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600;700&family=Fira+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
/* ============================================================================
   MINDWRITE TRADER — DESIGN SYSTEM
   Base:        Data-Dense Dashboard (BI/Analytics)
   Supplement:  Real-Time Monitoring + Financial Dashboard
   Accent:      HUD / Sci-Fi FUI
   Palette:     Dark Mode (OLED)
   Type:        Fira Code / Fira Sans
   ============================================================================ */
:root{
  /* ---- surfaces (OLED) ---- */
  --bg:#020617;
  --surface:#0E1223;
  --surface-2:#0A0E1C;
  --surface-3:#070B16;
  --muted:#1A1E2F;

  /* ---- foreground (all >= 4.5:1 on --bg) ---- */
  --fg:#F8FAFC;            /* 17.8:1 */
  --fg-soft:#CBD5E1;       /* 12.4:1 — log/body copy */
  --fg-muted:#94A3B8;      /*  7.3:1 — labels/secondary text */
  --fg-dim:#64748B;        /*  3.9:1 — DECORATIVE ONLY (separators, scrollbar) */

  /* ---- hairlines (HUD: 1px discipline) ---- */
  --line:#1E2638;
  --line-strong:#2A3449;
  --hud:#22D3EE;
  --hud-dim:rgba(34,211,238,.38);
  --glow:0 0 10px;

  /* ---- semantic data colors ---- */
  --profit:#22C55E;        /* financial: profit / live */
  --profit-soft:#34D399;
  --loss:#EF4444;
  --loss-soft:#FB7185;
  --warn:#F59E0B;
  --warn-soft:#FBBF24;
  --info:#38BDF8;
  --critical:#DC2626;
  --neutral:#A855F7;

  /* ---- data-dense rhythm tokens ---- */
  --grid-gap:8px;
  --card-pad:12px;
  --fs-xs:9px;
  --fs-sm:10px;
  --fs-base:11px;
  --fs-md:12px;
  --row-h:28px;
  --radius:6px;
  --radius-sm:4px;

  /* ---- motion tokens (context-aware, not one-size) ---- */
  --t-micro:150ms;         /* hover/press feedback */
  --t-state:240ms;         /* card + bar transitions */
  --ease:cubic-bezier(.4,0,.2,1);
  --pulse:pulse 2s cubic-bezier(.4,0,.6,1) infinite;

  --focus:#FFFFFF;
  --mono:'Fira Code', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  --sans:'Fira Sans', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
}

*{box-sizing:border-box;margin:0;padding:0}
html,body{background:var(--bg);color:var(--fg);font-family:var(--sans);-webkit-font-smoothing:antialiased}
body{padding-bottom:1.5rem;min-height:100vh}
::selection{background:rgba(34,197,94,.3)}
svg{display:block}
canvas{display:block;width:100%;height:100%}
button{font-family:inherit;border:none;background:none;color:inherit;cursor:pointer}
.mono{font-family:var(--mono)}
.tnum{font-variant-numeric:tabular-nums}
.b{font-weight:600}
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}

/* ---- ACCESSIBILITY: visible focus, never removed ---- */
:focus{outline:none}
:focus-visible{outline:2px solid var(--focus);outline-offset:2px;border-radius:var(--radius-sm)}

/* ---- ACCESSIBILITY: reduced motion → static final state ---- */
@media (prefers-reduced-motion: reduce){
  *,*::before,*::after{
    animation-duration:.01ms !important;animation-iteration-count:1 !important;
    transition-duration:.01ms !important;scroll-behavior:auto !important;
  }
}

/* ---- touch targets expand on coarse pointers ---- */
@media (pointer:coarse){
  .tap{min-height:44px;min-width:44px}
}

.scroll::-webkit-scrollbar{width:6px;height:6px}
.scroll::-webkit-scrollbar-track{background:transparent}
.scroll::-webkit-scrollbar-thumb{background:var(--line-strong);border-radius:3px}
.scroll::-webkit-scrollbar-thumb:hover{background:var(--fg-dim)}

@keyframes pulse{0%,100%{opacity:1}50%{opacity:.45}}
@keyframes ping{75%,100%{transform:scale(2.4);opacity:0}}
@keyframes marquee{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@keyframes flash{0%{background:rgba(34,211,238,.22)}100%{background:transparent}}
@keyframes rowin{from{opacity:0;transform:translateY(-4px)}to{opacity:1;transform:none}}

.wrap{max-width:1720px;margin:0 auto;padding:0 .75rem}
@media(min-width:640px){.wrap{padding:0 1.25rem}}

/* ============================ HEADER ============================ */
header.topbar{position:sticky;top:0;z-index:30;background:rgba(2,6,23,.94);
  backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.topbar-inner{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;
  gap:.5rem;padding:.5rem 0;min-height:56px}
.brand{display:flex;align-items:center;gap:.625rem}
.brand-logo{width:30px;height:30px;border-radius:var(--radius-sm);
  background:linear-gradient(145deg,rgba(34,197,94,.18),rgba(34,211,238,.1));
  border:1px solid var(--hud-dim);display:flex;align-items:center;justify-content:center;
  font-family:var(--mono);font-weight:700;font-size:11px;color:var(--hud);
  text-shadow:var(--glow) rgba(34,211,238,.55);position:relative}
.brand-title{font-family:var(--mono);font-weight:700;font-size:13px;letter-spacing:.08em;color:var(--fg)}
@media(max-width:640px){.brand-title{font-size:11px}}
.brand-title .sep{color:var(--fg-dim)}
.brand-title .accent{color:var(--profit-soft)}
.brand-badge{font-size:var(--fs-sm);font-family:var(--mono);padding:3px 7px;border-radius:var(--radius-sm);
  background:var(--surface-2);border:1px solid var(--line);color:var(--fg-muted);letter-spacing:.04em}
@media(max-width:860px){.brand-badge{display:none}}

.hmetrics{display:flex;flex-wrap:wrap;align-items:center;gap:.875rem;
  font-family:var(--mono);font-size:var(--fs-base);font-variant-numeric:tabular-nums}
@media(min-width:640px){.hmetrics{gap:1.25rem}}
.hm{padding:2px 4px;border-radius:var(--radius-sm)}
.hm.tick{animation:flash 700ms var(--ease)}
.hm-label{color:var(--fg-muted);display:block;font-size:var(--fs-xs);letter-spacing:.07em;font-weight:500}
.hm-val{font-weight:700;letter-spacing:.02em}
.hide-sm{display:none}@media(min-width:640px){.hide-sm{display:block}}
.hide-md{display:none}@media(min-width:768px){.hide-md{display:block}}

.stream-btn{display:inline-flex;align-items:center;gap:.4rem;padding:7px 11px;border-radius:var(--radius-sm);
  font-size:var(--fs-base);font-weight:600;letter-spacing:.04em;transition:background var(--t-micro) var(--ease),
  border-color var(--t-micro) var(--ease);font-family:var(--mono)}
.stream-btn.live{background:rgba(34,197,94,.14);color:var(--profit-soft);border:1px solid rgba(34,197,94,.42)}
.stream-btn.live:hover{background:rgba(34,197,94,.26)}
.stream-btn.paused{background:rgba(245,158,11,.14);color:var(--warn-soft);border:1px solid rgba(245,158,11,.42)}
.stream-btn.paused:hover{background:rgba(245,158,11,.26)}
.stream-btn svg{width:13px;height:13px}

/* ticker — auto-rotating content: pausable, stops on reduced motion */
.ticker{background:var(--surface-3);border-top:1px solid var(--line);padding:.3rem 0;overflow:hidden}
.ticker-inner{display:flex;align-items:center;gap:.75rem;font-size:var(--fs-base);font-family:var(--mono)}
.ticker-live{display:inline-flex;align-items:center;gap:.4rem;padding:3px 9px;border-radius:var(--radius-sm);
  font-size:var(--fs-sm);font-weight:700;flex-shrink:0;letter-spacing:.06em}
.ticker-live.on{background:rgba(220,38,38,.92);color:#fff}
.ticker-live.off{background:var(--muted);color:var(--fg-muted)}
.live-dot{position:relative;width:6px;height:6px}
.live-dot span{position:absolute;inset:0;border-radius:9999px;background:#fff}
.ticker-live.on .live-dot .ping{animation:ping 1.1s cubic-bezier(0,0,.2,1) infinite}
.ticker-view{flex:1;overflow:hidden;white-space:nowrap;
  -webkit-mask-image:linear-gradient(90deg,transparent,#000 3%,#000 97%,transparent);
          mask-image:linear-gradient(90deg,transparent,#000 3%,#000 97%,transparent)}
.ticker-track{display:inline-flex;gap:1.5rem;color:var(--fg-muted);animation:marquee 38s linear infinite;will-change:transform}
.ticker-track.paused{animation-play-state:paused}
.ticker-view:hover .ticker-track{animation-play-state:paused}
.tk-item{display:inline-flex;align-items:center;gap:.4rem}
.tk-tag{font-weight:700;letter-spacing:.06em}
.tk-text{color:var(--fg-muted)}

/* ============================ MAIN ============================ */
main{padding-top:1rem}
main .wrap > section{margin-bottom:var(--grid-gap)}
@media(min-width:1024px){main .wrap > section{margin-bottom:12px}}

/* HUD panel: hairline + corner tech markers */
.card{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);
  padding:var(--card-pad);position:relative}
.card::before,.card::after{content:'';position:absolute;width:9px;height:9px;
  border-color:var(--hud-dim);pointer-events:none;opacity:.75}
.card::before{top:-1px;left:-1px;border-top:1px solid;border-left:1px solid;border-top-left-radius:var(--radius)}
.card::after{bottom:-1px;right:-1px;border-bottom:1px solid;border-right:1px solid;border-bottom-right-radius:var(--radius)}
.card-col{display:flex;flex-direction:column;justify-content:space-between}
.inner{background:var(--surface-2);border:1px solid var(--line);border-radius:var(--radius-sm)}

.mtitle{font-size:var(--fs-base);font-family:var(--mono);font-weight:700;letter-spacing:.09em;color:var(--fg)}
.mtitle .sep{color:var(--fg-dim)}
.mtitle::before{content:'▸ ';color:var(--hud);opacity:.7}
.pill{font-size:var(--fs-sm);font-family:var(--mono);padding:2px 7px;border-radius:var(--radius-sm);letter-spacing:.05em}
.pill-hud{background:rgba(34,211,238,.1);color:var(--hud);border:1px solid var(--hud-dim)}
.row{display:flex;align-items:center;justify-content:space-between}
.row-wrap{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:.5rem}
.flC{display:flex;align-items:center}.gap2{gap:.5rem}.gap3{gap:.75rem}

/* grids — data-dense 12-col */
.grid-top{display:grid;grid-template-columns:1fr;gap:var(--grid-gap)}
@media(min-width:1024px){.grid-top{grid-template-columns:repeat(12,1fr);gap:12px}
  .gt-3{grid-column:span 3}.gt-6{grid-column:span 6}}
.grid-den{display:grid;grid-template-columns:1fr;gap:var(--grid-gap);align-items:stretch}
@media(min-width:1280px){.grid-den{grid-template-columns:repeat(12,1fr)}
  .gd-3{grid-column:span 3}.gd-6{grid-column:span 6}}
.grid-bottom{display:grid;grid-template-columns:1fr;gap:var(--grid-gap)}
@media(min-width:1280px){.grid-bottom{grid-template-columns:repeat(12,1fr);gap:12px}
  .gb-5{grid-column:span 5}.gb-7{grid-column:span 7}}
.grid-tt{display:grid;grid-template-columns:1fr;gap:var(--grid-gap)}
@media(min-width:768px){.grid-tt{grid-template-columns:1fr 1fr;gap:12px}}

.c-profit{color:var(--profit-soft)}.c-info{color:var(--info)}.c-loss{color:var(--loss-soft)}
.c-warn{color:var(--warn-soft)}.c-hud{color:var(--hud)}
.c-fg{color:var(--fg)}.c-mut{color:var(--fg-muted)}.c-dim{color:var(--fg-muted)}

/* ---- core model ---- */
.train-box{background:var(--surface-2);border:1px solid var(--line);border-radius:var(--radius-sm);
  padding:.5rem;margin-bottom:.75rem}
.big-counter{font-size:32px;line-height:1;font-family:var(--mono);font-weight:700;color:var(--profit-soft);
  font-variant-numeric:tabular-nums;letter-spacing:-.02em;text-shadow:var(--glow) rgba(34,197,94,.35)}
.act-bars{display:flex;align-items:flex-end;gap:3px;height:28px}
.act-bars span{width:5px;background:linear-gradient(180deg,var(--profit-soft),rgba(34,197,94,.35));border-radius:2px 2px 0 0}
.stat3{display:grid;grid-template-columns:repeat(3,1fr);gap:.5rem;padding-top:.625rem;margin-top:.625rem;
  border-top:1px solid var(--line);font-family:var(--mono);font-size:var(--fs-sm)}
.stat3 .k{color:var(--fg-muted);display:block;font-size:var(--fs-xs);letter-spacing:.06em}

/* ---- exit simulator ---- */
.exit-combo{display:grid;grid-template-columns:repeat(12,1fr);gap:.5rem;background:var(--surface-2);
  border:1px solid var(--line);border-radius:var(--radius-sm);padding:.625rem;align-items:center}
.exit-main{grid-column:span 9;position:relative}
.exit-hist{grid-column:span 3;height:144px;display:flex;flex-direction:column;justify-content:space-between;
  padding-left:.5rem;border-left:1px solid var(--line)}
.vbin-row{display:flex;align-items:center;justify-content:flex-end;height:8px}
.vbin{height:100%;border-radius:2px 0 0 2px;transition:width var(--t-state) var(--ease)}
.vbin.p{background:linear-gradient(90deg,rgba(34,197,94,.35),var(--profit))}
.vbin.w{background:linear-gradient(90deg,rgba(245,158,11,.35),var(--warn))}
.vbin.l{background:linear-gradient(90deg,rgba(239,68,68,.35),var(--loss))}
.exit-foot{display:grid;grid-template-columns:repeat(3,1fr);gap:.5rem .75rem;padding-top:.625rem;margin-top:.5rem;
  border-top:1px solid var(--line);font-family:var(--mono);font-size:var(--fs-base);font-variant-numeric:tabular-nums}
@media(min-width:520px){.exit-foot{grid-template-columns:repeat(5,1fr)}}
.foot-lab{color:var(--fg-muted);display:block;font-size:var(--fs-xs);letter-spacing:.06em}

/* ---- cluster radar ---- */
.radar-box{position:relative;background:var(--surface-2);border:1px solid var(--line);
  border-radius:var(--radius-sm);height:144px;overflow:hidden}
.legend{display:flex;align-items:center;justify-content:space-between;padding-top:.625rem;margin-top:.5rem;
  border-top:1px solid var(--line);font-family:var(--mono);font-size:var(--fs-sm);color:var(--fg-muted)}
.legend span{display:inline-flex;align-items:center;gap:5px}
.dot{width:7px;height:7px;border-radius:9999px}
.dot-sq{width:8px;height:8px;border-radius:2px}

/* ---- the den ---- */
.den-head{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:.5rem;
  padding-bottom:.75rem;margin-bottom:.75rem;border-bottom:1px solid var(--line)}
.den-title{display:flex;align-items:center;gap:.5rem}
.den-title svg{width:15px;height:15px;color:var(--profit-soft)}
.den-title span{font-size:var(--fs-md);font-family:var(--mono);font-weight:700;letter-spacing:.09em;color:var(--fg)}
.den-btn{padding:6px 11px;border-radius:var(--radius-sm);background:var(--surface-2);border:1px solid var(--line-strong);
  font-size:var(--fs-base);font-family:var(--mono);color:var(--fg);letter-spacing:.04em;
  transition:background var(--t-micro) var(--ease),border-color var(--t-micro) var(--ease)}
.den-btn:hover{background:var(--muted);border-color:var(--hud-dim)}

.obs-col,.dec-col{display:flex;flex-direction:column;justify-content:space-between;gap:5px}
.obs{background:var(--surface-2);border:1px solid var(--line);border-radius:var(--radius-sm);padding:6px 10px;
  display:flex;align-items:center;justify-content:space-between;gap:.5rem;
  transition:border-color var(--t-micro) var(--ease),background var(--t-micro) var(--ease)}
.obs:hover{border-color:var(--hud-dim);background:var(--muted)}
.obs-l{min-width:0}
.obs-name{display:flex;align-items:center;gap:6px}
.obs-name .d{width:6px;height:6px;border-radius:9999px;flex-shrink:0}
.obs-name .t{font-size:var(--fs-sm);font-family:var(--mono);font-weight:600;color:var(--fg);
  letter-spacing:.05em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.obs-sub{font-size:var(--fs-xs);font-family:var(--mono);color:var(--fg-muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.obs-spark{width:62px;height:20px;flex-shrink:0;overflow:visible}
.obs-r{text-align:right;font-family:var(--mono);flex-shrink:0;font-variant-numeric:tabular-nums}
.obs-val{font-size:var(--fs-base);font-weight:700;color:var(--fg)}
.obs-delta{font-size:var(--fs-xs);font-weight:500}

.den-canvas-box{position:relative;background:var(--surface-3);border:1px solid var(--line);
  border-radius:var(--radius);min-height:340px;overflow:hidden;display:flex;align-items:center;justify-content:center}
@media(min-width:640px){.den-canvas-box{min-height:420px}}
/* HUD scanline veil — subtle, keeps text legible */
.den-canvas-box::after{content:'';position:absolute;inset:0;pointer-events:none;
  background:repeating-linear-gradient(180deg,rgba(34,211,238,.035) 0 1px,transparent 1px 3px)}
.den-overlay{position:absolute;bottom:10px;left:12px;right:12px;display:flex;align-items:center;
  justify-content:space-between;gap:.5rem;font-size:var(--fs-sm);font-family:var(--mono);
  color:var(--fg-muted);pointer-events:none;z-index:2;letter-spacing:.05em}
.den-overlay .mode{color:var(--hud);text-shadow:var(--glow) rgba(34,211,238,.4)}
@media(max-width:520px){.den-overlay .edge{display:none}}

.dec{text-align:left;background:var(--surface-2);border:1px solid var(--line);border-radius:var(--radius-sm);
  padding:6px 10px;transition:border-color var(--t-micro) var(--ease),background var(--t-micro) var(--ease);width:100%}
.dec:hover{border-color:var(--hud-dim);background:var(--muted)}
.dec[aria-pressed="true"]{border-color:rgba(34,197,94,.65);box-shadow:0 0 0 1px rgba(34,197,94,.28),inset 2px 0 0 var(--profit)}
.dec-top{display:flex;align-items:center;justify-content:space-between;gap:.5rem}
.dec-badge{padding:1px 6px;border-radius:3px;border:1px solid;font-size:var(--fs-xs);
  font-family:var(--mono);font-weight:700;letter-spacing:.06em}
.badge-buy{background:rgba(34,197,94,.18);color:var(--profit-soft);border-color:rgba(34,197,94,.45)}
.badge-watch{background:rgba(245,158,11,.18);color:var(--warn-soft);border-color:rgba(245,158,11,.45)}
.badge-skip{background:rgba(239,68,68,.18);color:var(--loss-soft);border-color:rgba(239,68,68,.45)}
.dec-sym{font-size:var(--fs-md);font-family:var(--mono);font-weight:700;color:var(--fg)}
.dec-score{font-size:15px;font-family:var(--mono);font-weight:700;font-variant-numeric:tabular-nums}
.dec-reason{display:block;font-size:var(--fs-sm);font-family:var(--mono);color:var(--fg-muted);
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:2px}
.conf{display:block;width:100%;height:3px;background:var(--muted);border-radius:9999px;overflow:hidden;margin-top:6px}
.conf > *{display:block;height:100%;border-radius:9999px;transition:width var(--t-state) var(--ease)}

/* ---- slot buyer ---- */
.slot-box{background:var(--surface-2);border:1px solid var(--line);border-radius:var(--radius-sm);
  padding:.75rem;height:192px;display:flex;align-items:flex-end;justify-content:space-between;gap:5px}
.slot-col{flex:1;height:100%;display:flex;flex-direction:column;justify-content:flex-end;align-items:center}
.slot-stack{width:100%;max-width:22px;display:flex;flex-direction:column;justify-content:flex-end;
  border-radius:3px 3px 0 0;overflow:hidden;transition:height var(--t-state) var(--ease)}
.slot-stack .snipe{background:var(--warn);width:100%;opacity:.85}
.slot-stack .arb{background:var(--info);width:100%;opacity:.85}
.slot-stack .org{background:var(--profit);width:100%;opacity:.92}
.slot-lab{font-size:var(--fs-xs);font-family:var(--mono);color:var(--fg-muted);margin-top:6px}

/* ---- trade tape (sticky header) ---- */
.tt-box{background:var(--surface-2);border:1px solid var(--line);border-radius:var(--radius-sm);
  overflow:auto;flex:1;max-height:214px}
table.tt{width:100%;text-align:left;border-collapse:collapse;font-family:var(--mono);
  font-size:var(--fs-sm);font-variant-numeric:tabular-nums}
table.tt thead th{position:sticky;top:0;z-index:1;background:var(--muted);color:var(--fg-muted);
  padding:7px 8px;font-weight:600;letter-spacing:.06em;border-bottom:1px solid var(--line-strong);font-size:var(--fs-xs)}
table.tt td{padding:6px 8px;border-top:1px solid var(--line)}
table.tt tbody tr{transition:background var(--t-micro) var(--ease)}
table.tt tbody tr:hover{background:var(--muted)}
table.tt tbody tr:first-child{animation:rowin 320ms var(--ease)}
.ta-r{text-align:right}

/* ---- agent log ---- */
.logf{display:flex;align-items:center;gap:3px;font-family:var(--mono);font-size:var(--fs-xs)}
.logf button{padding:4px 7px;border-radius:3px;transition:all var(--t-micro) var(--ease);
  background:var(--surface-2);color:var(--fg-muted);border:1px solid var(--line);letter-spacing:.05em}
.logf button:hover{color:var(--fg);border-color:var(--line-strong)}
.logf button[aria-pressed="true"]{background:rgba(34,197,94,.18);color:var(--profit-soft);border-color:rgba(34,197,94,.45)}
.log-box{background:var(--surface-2);border:1px solid var(--line);border-radius:var(--radius-sm);
  padding:.5rem;height:214px;overflow-y:auto;font-family:var(--mono);font-size:var(--fs-sm);
  display:flex;flex-direction:column;gap:6px}
